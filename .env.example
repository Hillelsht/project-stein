# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers (free tiers)
GEMINI_API_KEY=
GROQ_API_KEY=

# Cron auth (generate with: openssl rand -hex 32)
CRON_SECRET=

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your@email.com

# SEC requires contact info in User-Agent header
SEC_USER_AGENT=ProjectStein/1.0 (your@email.com)

# App
NEXT_PUBLIC_APP_URL=

# ── Stein 2.0 ───────────────────────────────────────────────────────────────

# IBKR Flex Web Service (Client Portal → Performance & Reports → Flex Queries
# for the query id; Settings → Account Settings → Flex Web Service for the token)
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# Brief delivery (Resend free tier). BRIEF_FROM_EMAIL is optional — the default
# onboarding@resend.dev can email the Resend account owner without a verified domain.
RESEND_API_KEY=
BRIEF_RECIPIENT_EMAIL=
BRIEF_FROM_EMAIL=

# Dispatches the Claude brief worker in GitHub Actions.
# Fine-grained PAT scoped to this repo with the "actions: write" permission.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=owner/repo
